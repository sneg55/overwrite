# Required environment variables. Copy to .env and fill in values.
# The single env boundary is backend/src/utils/env.ts (Zod-validated at startup).
#
# Public HackCanton devnet values are pre-filled below (verified reachable
# 2026-07-06). Only the SECRETS are blank: your personal OIDC_USERNAME/PASSWORD and
# the party ids you generate on your node.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Canton / JSON Ledger API (HackCanton devnet, verified live: Canton 3.5.6) ──
LEDGER_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
LEDGER_API_GRPC=ledger-api-grpc.participant.hackcanton-01.devnet.naas.noders.services:443
VALIDATOR_API_URL=https://validator-api-http.validator.hackcanton-01.devnet.naas.noders.services
AUDIENCE=https://hackcanton-01.devnet.naas.noders.services

# ── DA Registry + CBTC (from cbtc-lib devnet config) ──────────────────────────
REGISTRY_URL=https://api.utilities.digitalasset-dev.com
CBTC_NETWORK_PARTY=cbtc-network::12202a83c6f4082217c175e29bc53da5f2703ba2675778ab99217a5a881a949203ff
BITSAFE_API_URL=https://api.devnet.bitsafe.finance

# Wire the collateral lock and ITM settle to the REAL CBTC registry: fetch each
# allocation's off-ledger choice context and attach the registry's disclosed
# contracts to the submission. Leave false for the local sandbox, which runs
# against the labeled MockAllocationFactory. Setting true requires REGISTRY_URL
# and CBTC_NETWORK_PARTY above to be reachable and the DAR to be vetted on the
# target participant.
USE_REAL_REGISTRY=false
# The collateral allocation window, passed to Vault.LockCollateral as choice
# arguments (the registry's choice context is fetched for the exact arguments a
# submission carries, so Daml cannot pick these itself). SETTLE_BUFFER_MS must be
# at least the vault's own settleBufferSeconds or the lock is rejected on-ledger;
# the seed scripts create vaults with a 1 hour buffer, matching this default.
ALLOCATE_WINDOW_MS=86400000
SETTLE_BUFFER_MS=3600000

# ── Keycloak / OIDC (password grant; SECRETS are yours to fill) ───────────────
OIDC_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
OIDC_CLIENT_ID=web-app-ui-hackcanton-01-devnet
OIDC_SCOPE=openid daml_ledger_api offline_access
OIDC_USERNAME=
OIDC_PASSWORD=

# REST session map (demo): binds a caller bearer token to one party, server-side.
# Format: "token=party,token=party". Empty -> ledger-backed REST routes return 401.
SESSIONS=

# ── CBTC faucet (devnet; plain JSON API, no auth) ─────────────────────────────
# The faucet moved to per-network subdomains (2026-07-13). The apex
# cbtc-faucet.bitsafe.finance still serves the UI but its /api is dead (empty
# networks); the live API is on the subdomain below (testnet: cbtc-faucet.testnet…).
FAUCET_URL=https://cbtc-faucet.devnet.bitsafe.finance
FAUCET_NETWORK=devnet

# ── Demo parties (backend-owned, labeled custodial; generate on your node) ────
# All three are required by env.ts (.min(1)); the backend will not boot while any
# is blank. Your node party is your OIDC user's primaryParty: read it from
# GET /v2/users/{sub} (the token's `sub` claim), since GET /v2/parties is admin-only.
# On a single-party devnet node these collapse to one party until distinct oracle /
# mm-buyer / depositor parties are provisioned. Distinct parties are required for
# real DvP and for the privacy reveal to mean anything, so collapsing them is a
# deliberate single-node compromise, not the target state.
OPERATOR_PARTY=
ORACLE_PARTY=
MM_BUYER_PARTY=

# ── Party hint namespacing (web) ──────────────────────────────────────────────
# A party id is `<hint>::<namespace>`. The local sandbox allocates the hint the app
# expects (`alice`), but a SHARED participant namespaces hints so teams do not collide:
# HackCanton devnet allocates `alice-overwrite`, `mm-buyer-overwrite`, and so on. Set
# this to that suffix and the web strips it back to the name the app compares against.
#
# Leave BLANK for the local sandbox. Getting it wrong on devnet fails silently rather
# than loudly: the depositor's own-position filter, the withdraw button's ownership
# check and the premium join all just stop matching, so a depositor sees an empty book
# that looks exactly like the privacy model working correctly.
OVERWRITE_PARTY_HINT_SUFFIX=

# ── Oracle price source (public BTC spot API; Chainlink if 0.4 GO) ────────────
PRICE_API_URL=

# ── Engine control channel ────────────────────────────────────────────────────
# Where the REST server and the epoch scheduler exchange pause/step intent and
# engine status. They are separate OS processes, so an in-memory handle cannot
# cross between them; two JSON files in this directory carry it, each with a
# single writer (the server owns intent, the scheduler owns status).
#
# The only property that matters is that BOTH processes agree on this path.
# Override it in tandem or not at all. scripts/sandbox.sh exports it absolutely
# for local runs, so this is only needed when launching the processes yourself.
# Default is .sandbox relative to backend/, which resolves correctly only when
# the process was started from that directory.
ENGINE_CONTROL_DIR=
