{
  "$schema": "../node_modules/testreel/recording-definition.schema.json",
  "url": "http://localhost:3000/app/position",
  "viewport": { "width": 1280, "height": 720 },
  "colorScheme": "dark",
  "outputFormat": "mp4",
  "cookies": [
    { "name": "overwrite-party", "value": "operator", "domain": "localhost", "path": "/" }
  ],
  "cursor": {
    "enabled": true,
    "size": 26,
    "color": "#f7931a",
    "rippleColor": "#ffb454",
    "rippleSize": 44,
    "idleHide": false,
    "transitionMs": 650
  },
  "steps": [
    { "action": "wait", "ms": 3400 },
    { "action": "scroll", "y": 200 },
    { "action": "wait", "ms": 3200 },
    { "action": "scroll", "y": 180 },
    { "action": "wait", "ms": 3400 },
    { "action": "scroll", "y": -380 },
    { "action": "wait", "ms": 1400 },
    { "action": "select", "selector": "#party", "value": "alice" },
    { "action": "wait", "ms": 4000 },
    { "action": "scroll", "y": 620 },
    { "action": "wait", "ms": 3600 },
    { "action": "scroll", "y": 340 },
    { "action": "wait", "ms": 3000 }
  ]
}
