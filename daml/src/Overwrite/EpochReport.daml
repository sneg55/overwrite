-- Per-depositor aggregate report. One copy is created per epoch depositor, each
-- visible only to that depositor. Aggregates ONLY: totals + a count, never the set
-- of depositor identities (that would leak the book, since a contract's observers
-- are visible to its stakeholders). The per-depositor payout detail lives in each
-- depositor's own PremiumReceipt.
module Overwrite.EpochReport where

import Overwrite.Types

template EpochReport
  with
    operator : Party
    depositor : Party     -- the single observer this copy is for
    epochNumber : Int
    settlementPath : SettlementPath
    totalPremiumUsdc : Decimal
    totalNotionalCbtc : Decimal
    depositorCount : Int
    collateralReturned : Bool
    tsSettled : Time
    -- Settlement facts copied from EpochSettlement, which is signatory
    -- operator, mmBuyer and so unreadable by a depositor. Without the copy a
    -- depositor can see THAT their epoch was exercised but never the price that
    -- exercised it or the strike it was measured against.
    --
    -- Optional because Canton upgrade validation rejects non-Optional field
    -- additions; that rule is what the 0.1.1 upload failed. Both are always
    -- written as Some. None means the report predates overwrite-vault 1.1.0 and
    -- must never render as a zero price.
    observedPrice : Optional Decimal
    strikeUsdcPerCbtc : Optional Decimal
  where
    signatory operator
    observer depositor
